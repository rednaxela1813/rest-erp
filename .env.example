# =============================================================================
# Django Core Settings
# =============================================================================

# CRITICAL: Generate a new secret key for production!
# You can use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production

# Debug mode - NEVER enable in production
DJANGO_DEBUG=True

# Allowed hosts - comma separated list of domains/IPs
# For local development: localhost,127.0.0.1
# For production: yourdomain.com,yourapp.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================

POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=auth_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =============================================================================
# Redis & Celery Configuration  
# =============================================================================

# Main Celery broker and result backend
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Device commands Redis streams configuration
DEVICE_COMMANDS_REDIS_URL=redis://redis:6379/0
DEVICE_COMMANDS_STREAM=device_commands
DEVICE_COMMANDS_STREAM_MAXLEN=10000
DEVICE_COMMANDS_RETRY_BASE_SECONDS=10
DEVICE_COMMANDS_RETRY_MAX_SECONDS=300

# =============================================================================
# Fiscal Integration Settings
# =============================================================================

# Mock fiscal mode (for development/testing)
# WARNING: FISCAL_MOCK_ENABLED and EKASA_ENABLED cannot both be True
FISCAL_MOCK_ENABLED=True
FISCAL_MOCK_OFFLINE=False
FISCAL_RECONCILE_ENABLED=True

# =============================================================================
# eKasa Integration (Slovak fiscal system)
# =============================================================================

# Enable eKasa integration (set to True for production in Slovakia)
# WARNING: Cannot be True when FISCAL_MOCK_ENABLED=True
EKASA_ENABLED=False

# eKasa API configuration (required when EKASA_ENABLED=True)
EKASA_BASE_URL=https://api.ekasa.sk
EKASA_API_KEY=your-ekasa-api-key
EKASA_TIMEOUT_S=30
EKASA_USERNAME=your-ekasa-username  
EKASA_PASSWORD=your-ekasa-password
EKASA_CASH_REGISTER_CODE=your-cash-register-code

# =============================================================================
# Logging & Monitoring
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable database logging
LOG_DB_ENABLED=True

# Automatic log cleanup
LOG_RETENTION_ENABLED=True
LOG_RETENTION_DAYS=30

# =============================================================================
# Application Settings
# =============================================================================

# Default currency for the application
DEFAULT_CURRENCY=EUR

# Cashier device authentication token
CASHIER_DEVICE_TOKEN=optional-device-token

# =============================================================================
# Development Notes
# =============================================================================

# 1. Copy this file to .env and customize the values
# 2. Generate a new DJANGO_SECRET_KEY for production
# 3. Set DJANGO_DEBUG=False in production
# 4. Configure proper DJANGO_ALLOWED_HOSTS for production
# 5. Use strong database credentials in production
# 6. Configure eKasa settings if deploying in Slovakia
# 7. Consider using environment-specific .env files (.env.dev, .env.prod)

# =============================================================================
# Docker Compose Notes  
# =============================================================================

# This .env file is automatically used by docker-compose.yml
# Default services:
# - PostgreSQL on port 5432
# - Redis on port 6379  
# - Django web server on port 8000
# - Celery worker and beat scheduler

# Health check endpoints:
# - http://localhost:8000/health
# - http://localhost:8000/api/docs/ (Swagger UI)
# - http://localhost:8000/admin/ (Django admin)